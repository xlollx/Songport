<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Sync manuali lunghe in primo piano con notifica di avanzamento (tipo dataSync). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Necessario per aprire il browser (Custom Tabs) per il login OAuth su Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Connector plugins: apps implementing Songport's open connector interface advertise this action. -->
        <intent>
            <action android:name="com.xlollx.songport.action.CONNECTOR" />
        </intent>
    </queries>

    <application
        android:name=".SongportApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Songport">

        <!-- AdMob: App ID (di default quello di TEST Google; il vero arriva da ADMOB_APP_ID). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Songport.Starting"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- "Condividi con Songport" da Spotify, Apple Music, YouTube…: il link diventa l'origine di una sync. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Login Apple Music: MusicKit JS dentro una WebView (Apple non ha un OAuth da app). -->
        <activity
            android:name=".auth.AppleAuthActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Widget home: ultima sync + "Sincronizza tutto". -->
        <receiver
            android:name=".widget.SyncWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.xlollx.songport.widget.SYNC_ALL" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sync_info" />
        </receiver>

        <!-- Pausa / riprendi / interrompi dalla notifica di avanzamento. -->
        <receiver
            android:name=".sync.SyncControlReceiver"
            android:exported="false" />

        <!-- WorkManager in primo piano: dichiara il tipo di servizio richiesto da Android 14+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Accesso a server personali (Subsonic/Navidrome, Jellyfin, Plex) e sorgenti a nome utente. -->
        <activity
            android:name=".auth.ServerLoginActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <!-- Sblocco con impronta/PIN (BiometricPrompt richiede una FragmentActivity). -->
        <activity
            android:name=".auth.LockActivity"
            android:exported="false"
            android:theme="@style/Theme.Songport" />

        <!-- Riceve il redirect OAuth dal browser: songport://callback e lo schema Google. -->
        <activity
            android:name=".auth.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Songport">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="songport" android:host="callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${googleRedirectScheme}" />
            </intent-filter>
        </activity>

    </application>
</manifest>
