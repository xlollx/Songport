<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Sync manuali lunghe in primo piano con notifica di avanzamento (tipo dataSync). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Necessario per aprire il browser (Custom Tabs) per il login OAuth su Android 11+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Connector plugins: apps implementing Songport's open connector interface advertise this action. -->
        <intent>
            <action android:name="com.xlollx.songport.action.CONNECTOR" />
        </intent>
    </queries>

    <application
        android:name=".SongportApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Songport">

        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.Songport.Starting"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
            <!-- "Condividi con Songport" da Spotify, Apple Music, YouTube…: il link diventa l'origine di una sync. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- "Open with Songport" for track and playlist links: off until the user turns it on in Settings
             (PackageManager enables the alias). No autoVerify on purpose: Android offers Songport next to
             the service's app in its chooser; it never takes a link by itself. -->
        <activity-alias
            android:name=".MusicLinkActivity"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="open.spotify.com" />
                <data android:host="spotify.link" />
                <data android:host="music.apple.com" />
                <data android:host="music.youtube.com" />
                <data android:host="youtu.be" />
                <data android:host="www.deezer.com" />
                <data android:host="deezer.com" />
                <data android:host="deezer.page.link" />
                <data android:host="tidal.com" />
                <data android:host="listen.tidal.com" />
                <data android:host="link.tidal.com" />
                <data android:host="music.amazon.com" />
                <data android:host="music.amazon.co.uk" />
                <data android:host="music.amazon.de" />
                <data android:host="music.amazon.fr" />
                <data android:host="music.amazon.it" />
                <data android:host="music.amazon.es" />
                <data android:host="music.amazon.ca" />
                <data android:host="music.amazon.com.au" />
                <data android:host="music.amazon.co.jp" />
                <data android:host="music.amazon.com.br" />
                <data android:host="music.amazon.com.mx" />
                <data android:host="music.amazon.in" />
                <data android:host="music.amazon.nl" />
                <data android:host="music.amazon.se" />
                <data android:host="music.amazon.pl" />
            </intent-filter>
        </activity-alias>

        <!-- Login Apple Music: MusicKit JS dentro una WebView (Apple non ha un OAuth da app). -->
        <activity
            android:name=".auth.AppleAuthActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- The cards (compatibility, poster) leave the app as PNG files through the share sheet. -->
        <!-- Its own subclass: the bridge module declares the plain FileProvider for its captures, and
             the manifest merger would fold two declarations of the same class into one. -->
        <provider
            android:name=".ui.CardsFileProvider"
            android:authorities="${applicationId}.cards"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- Widget home: ultima sync + "Sincronizza tutto". -->
        <receiver
            android:name=".widget.SyncWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.xlollx.songport.widget.SYNC_ALL" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_sync_info" />
        </receiver>

        <!-- Quick Settings tile "Sync all": runs every sync; its subtitle says when the last ran. -->
        <service
            android:name=".widget.SyncAllTile"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/shortcut_sync_all_short"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Pausa / riprendi / interrompi dalla notifica di avanzamento. -->
        <receiver
            android:name=".sync.SyncControlReceiver"
            android:exported="false" />

        <!-- WorkManager in primo piano: dichiara il tipo di servizio richiesto da Android 14+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Accesso a server personali (Subsonic/Navidrome, Jellyfin, Plex) e sorgenti a nome utente. -->
        <activity
            android:name=".auth.ServerLoginActivity"
            android:exported="false"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />

        <!-- Sblocco con impronta/PIN (BiometricPrompt richiede una FragmentActivity). -->
        <activity
            android:name=".auth.LockActivity"
            android:exported="false"
            android:theme="@style/Theme.Songport" />

        <!-- The service's own sign-in page inside the app (Spotify, Deezer, TIDAL): see WebAuthActivity. -->
        <activity
            android:name=".auth.WebAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.Songport" />

        <!-- Riceve il redirect OAuth dal browser: songport://callback e lo schema Google. -->
        <activity
            android:name=".auth.AuthCallbackActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Songport">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="songport" android:host="callback" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${googleRedirectScheme}" />
            </intent-filter>
        </activity>

    </application>
</manifest>
