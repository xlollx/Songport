<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base solo per la finestra; l'UI e' Jetpack Compose (Material3). -->
    <style name="Theme.Songport" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Schermata di avvio: finestra nera e l'icona (fascio, piastrella di vetro, marchio) al
         centro, come sul launcher; poi passa al tema normale. -->
    <style name="Theme.Songport.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <!-- The mark with its ring turning once (Android 12+ plays it; older phones show it still). -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">700</item>
        <item name="postSplashScreenTheme">@style/Theme.Songport</item>
    </style>
</resources>
