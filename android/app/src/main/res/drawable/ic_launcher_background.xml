<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Sfondo dell'icona: "il fascio". Base quasi nera attraversata da una banda luminosa
        inclinata di 12°, il cui bordo passa per (72,36): sotto il bordo un bagliore rosso cupo,
        sul bordo una riga blu-viola, sopra ciano che schiarisce fino al bianco. Stessi colori e
        stesse proporzioni (in unità di altezza) di scripts/store_graphics.sh, del sito (site.css,
        .hero) e dell'app (ui/Theme.kt, Brand.beam); la sfumatura corre lungo la perpendicolare
        al bordo, da 0.45 H sotto a 0.61 H sopra.
    -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="61.90" android:startY="83.54"
                android:endX="85.70" android:endY="-28.44">
                <item android:offset="0.0000" android:color="#FF000000" />
                <item android:offset="0.4170" android:color="#FF400000" />
                <item android:offset="0.4321" android:color="#FF421AFF" />
                <item android:offset="0.5000" android:color="#FF59FFFF" />
                <item android:offset="1.0000" android:color="#FFFFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
