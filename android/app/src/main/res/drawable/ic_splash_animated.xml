<?xml version="1.0" encoding="utf-8"?>
<!-- The splash icon: the mark with its sync ring turning a quarter turn as the app opens. The
     note stays still. Same shapes as ic_launcher_foreground, so the icon lands where the app's
     icon is; the system cross-fades it into the first screen. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:name="ring" android:pivotX="54" android:pivotY="54">
                <path android:pathData="M30.6,40.5 A27,27 0 0 1 77.4,40.5"
                    android:strokeColor="#FFFFFFFF" android:strokeWidth="5.5" android:strokeLineCap="round" />
                <path android:pathData="M77.4,67.5 A27,27 0 0 1 30.6,67.5"
                    android:strokeColor="#FFFFFFFF" android:strokeWidth="5.5" android:strokeLineCap="round" />
                <path android:fillColor="#FFFFFFFF" android:pathData="M81.85,36.2 L71.45,42.2 L81.4,47.4 Z" />
                <path android:fillColor="#FFFFFFFF" android:pathData="M26.15,71.8 L36.55,65.8 L26.6,60.6 Z" />
            </group>
            <group android:translateX="2.1" android:translateY="1.5">
                <path android:fillColor="#FFFFFFFF" android:pathData="M54.08,61.11 A7,5.6 -20 1 1 40.92,65.89 A7,5.6 -20 1 1 54.08,61.11 Z" />
                <path android:pathData="M52.6,62.5 L52.6,37.5"
                    android:strokeColor="#FFFFFFFF" android:strokeWidth="3.6" android:strokeLineCap="round" />
                <path android:fillColor="#FFFFFFFF" android:pathData="M52.6,37.2 C58.5,38.6 63.4,42.4 63.2,49.6 C61.6,45.2 58,42.9 52.6,42.6 Z" />
            </group>
        </vector>
    </aapt:attr>
    <target android:name="ring">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:valueFrom="0"
                android:valueTo="90"
                android:duration="700"
                android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
</animated-vector>
