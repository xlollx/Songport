<!-- Trackhop Desktop for Chocolatey (packaging/README.md). The version, and the address and checksum
     in tools/chocolateyinstall.ps1, are set for each release by packaging/chocolatey/update.ps1, which
     the Desktop workflow runs before `choco pack` and `choco push`. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>trackhop</id>
    <version>0.5.1</version>
    <title>Trackhop Desktop</title>
    <authors>xlollx</authors>
    <owners>xlollx</owners>
    <projectUrl>https://xlollx.github.io/Trackhop/</projectUrl>
    <projectSourceUrl>https://github.com/xlollx/Trackhop</projectSourceUrl>
    <packageSourceUrl>https://github.com/xlollx/Trackhop/tree/main/packaging/chocolatey</packageSourceUrl>
    <docsUrl>https://xlollx.github.io/Trackhop/guide/desktop</docsUrl>
    <bugTrackerUrl>https://github.com/xlollx/Trackhop/issues</bugTrackerUrl>
    <iconUrl>https://xlollx.github.io/Trackhop/store/icon512.png</iconUrl>
    <licenseUrl>https://github.com/xlollx/Trackhop/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
