<!-- Trackhop Desktop's AppStream metadata, for Flathub and the Linux software centres
     (packaging/flatpak, packaging/README.md). Add a <release> for each server-v version. -->
<component type="desktop-application">
  <id>io.github.xlollx.Trackhop</id>
  <name>Trackhop</name>
  <summary>Keep your playlists in sync</summary>
  <developer id="io.github.xlollx">
    <name>xlollx</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>
      Trackhop keeps the same playlist identical on several music services, on a schedule, without
      rebuilding it by hand. It is the sync engine of the Trackhop Android app as a program for your
      computer: it runs in the background with an icon next to the clock and keeps running the
      scheduled syncs while the computer is on.
    </p>
    <ul>
      <li>Spotify, YouTube and TIDAL with your own developer key</li>
      <li>Navidrome and other Subsonic servers, Jellyfin and Plex</li>
      <li>Last.fm, ListenBrainz and SoundCloud links as sources, and CSV, M3U and other playlist files</li>
      <li>One-way or two-way syncs, hourly to weekly, with a report of what was added and what was not found</li>
      <li>Radio syncs: the songs an internet radio plays, saved to a playlist</li>
      <li>Full backups of your playlists, and an API for Home Assistant, scripts and Prometheus</li>
    </ul>
    <p>
      Its pages open in its own window, and in any browser on this computer at 127.0.0.1, port 8642;
      nothing outside the computer can reach them. Sign-ins and keys stay on your computer.
    </p>
    <p>
      Trackhop Desktop is a beta: it works for everyday use, but its pages and settings can still
      change between releases.
    </p>
  </description>

  <launchable type="desktop-id">io.github.xlollx.Trackhop.desktop</launchable>
  <provides>
